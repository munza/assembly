# Copy to .assembly/.env and fill in.
# Real environment variables always win over this file (godotenv).

# Linear API key: linear.app -> Settings -> Security & access -> Personal API keys
# Referenced from .assembly/settings.json as: "api_key": "${LINEAR_API_KEY}"
LINEAR_API_KEY=

# Optional — normally set automatically in worker tabs by `task execute`:
# FOREMAN_STATE_DIR=/absolute/path/to/assembly/.assembly
# FOREMAN_BIN=/absolute/path/to/assembly/.assembly/bin/foreman
